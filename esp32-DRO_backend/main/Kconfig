menu "DRO Configuration"

    menu "UART Configuration"
        config DRO_UART_PORT_NUM
            int "UART Port Number"
            default 1
            help
                UART port to communicate with Frontend (0, 1, or 2).

        config DRO_UART_TX_PIN
            int "UART TX Pin"
            default 17
            help
                Pin connected to Frontend RX.

        config DRO_UART_RX_PIN
            int "UART RX Pin"
            default 16
            help
                Pin connected to Frontend TX.
    endmenu

    menu "Encoder Configuration"
        config DRO_ENABLE_AXIS_0
            bool "Enable Axis 0"
            default y
        if DRO_ENABLE_AXIS_0
            config DRO_ENC_AXIS_0_A
                int "Axis 0 A-Phase Pin"
                default 25
            config DRO_ENC_AXIS_0_B
                int "Axis 0 B-Phase Pin"
                default 26
        endif

        config DRO_ENABLE_AXIS_1
            bool "Enable Axis 1"
            default y
        if DRO_ENABLE_AXIS_1
            config DRO_ENC_AXIS_1_A
                int "Axis 1 A-Phase Pin"
                default 27
            config DRO_ENC_AXIS_1_B
                int "Axis 1 B-Phase Pin"
                default 14
        endif

        config DRO_ENABLE_AXIS_2
            bool "Enable Axis 2"
            default y
        if DRO_ENABLE_AXIS_2
            config DRO_ENC_AXIS_2_A
                int "Axis 2 A-Phase Pin"
                default 12
            config DRO_ENC_AXIS_2_B
                int "Axis 2 B-Phase Pin"
                default 13
        endif

        config DRO_ENABLE_AXIS_3
            bool "Enable Axis 3"
            default n
        if DRO_ENABLE_AXIS_3
            config DRO_ENC_AXIS_3_A
                int "Axis 3 A-Phase Pin"
                default 15
            config DRO_ENC_AXIS_3_B
                int "Axis 3 B-Phase Pin"
                default 2
        endif

        config DRO_ENABLE_AXIS_4
            bool "Enable Axis 4"
            default n
        if DRO_ENABLE_AXIS_4
            config DRO_ENC_AXIS_4_A
                int "Axis 4 A-Phase Pin"
                default 4
            config DRO_ENC_AXIS_4_B
                int "Axis 5 B-Phase Pin"
                default 5
        endif
    endmenu

    menu "Debug Configuration"
        config DRO_DEBUG_SIMULATE_DATA
            bool "Simulate Encoder Data (Demo Mode)"
            default n
            help
                If enabled, the backend will ignore hardware encoders and generate 
                fake moving patterns (sine waves/counters) for all enabled axes.
                Useful for testing the Frontend UI without physical encoders.
    endmenu

endmenu
